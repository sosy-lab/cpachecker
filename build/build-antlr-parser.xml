<!-- vim: set tabstop=8 shiftwidth=4 expandtab filetype=ant : -->
<project name="Base script for ANTLR parser generation" default="generate-antlr4-grammar" basedir=".">
    <!-- The importing file sets basedir to the "CPAchecker" directory and defines the properties
         antlr.dir (directory of the grammar), antlr.package (package of the generated files),
         and parser.source (name of the grammar). The files are generated in antlr.dir/generated. -->
    <property name="antlr.generated.dir" location="${antlr.dir}/generated"/>

    <target name="clean" description="Delete generated files">
        <delete dir="${antlr.generated.dir}"/>
    </target>

    <path id="classpath.antlr4">
        <pathelement location="./lib/java/build/antlr4.jar"/>
        <pathelement location="./lib/java/build/antlr-runtime.jar"/>
        <pathelement location="./lib/java/build/antlr4-runtime.jar"/>
        <pathelement location="./lib/java/build/ST4.jar"/>
    </path>

    <uptodate srcfile="${antlr.dir}/${parser.source}.g4" property="is.antlr4.parser.uptodate">
        <compositemapper>
            <mergemapper to="${antlr.generated.dir}"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}BaseVisitor.java"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}Lexer.java"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}Lexer.interp"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}Lexer.tokens"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}Parser.java"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}Visitor.java"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}.interp"/>
            <mergemapper to="${antlr.generated.dir}/${parser.source}.tokens"/>
        </compositemapper>
    </uptodate>

    <target name="generate-antlr4-parser" unless="is.antlr4.parser.uptodate">
        <java classname="org.antlr.v4.Tool" fork="true" failonerror="true" dir="${antlr.dir}">
            <arg value="-o"/>
            <arg value="generated"/>
            <arg value="-package"/>
            <arg value="${antlr.package}"/>
            <arg value="-visitor"/>
            <arg value="-no-listener"/>
            <arg value="${parser.source}.g4"/>
            <classpath>
                <path refid="classpath.antlr4"/>
            </classpath>
        </java>
        <property name="annotation"
                  value="@javax.annotation.processing.Generated(&quot;Antlr&quot;)${line.separator}"/>
        <replace file="${antlr.generated.dir}/${parser.source}Parser.java" token="@SuppressWarnings"
                 value="${annotation}@SuppressWarnings"/>
        <echo message="Generated parser-files in ${antlr.generated.dir}/*" level="info"/>
    </target>

    <target name="generate-antlr4-grammar" depends="generate-antlr4-parser"
            description="Generate antlr4 parser">
    </target>
</project>

(set-logic ALL)

(set-info :format-version 1.0)

(declare-fun address (Int) Int)

(define-proc
  main
  ((x Int))
  ()
  ((y Int))
  (! (sequence
    (assign (y (+ 5 x)))
    (! (sequence)
      :tag check
      :check-true (= y (+ x 5))
      :check-true (= (address y) (address (+ x 5))))) :tag main-body))

(declare-var x Int)
(verify-call main (x))
(get-witness)

(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (!
    (sequence
      (assign (i 0))
      (assign (j 0))
      (assign (k 0))
      (!
        (while
          (< k 268435455)
          (sequence
            (assign (i (+ i 1)))
            (assign (j (+ j 2)))
            (assign (k (+ k 3)))
            (! (sequence) :tag main-check-1)))
        :tag
        main-while-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= k (+ i j)))

(verify-call main ())

(get-witness)

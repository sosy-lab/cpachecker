; A logic with reals but without integers, where a numeral is a real
(set-logic QF_LRA)
(define-proc main () () ((x Real) (y Real))
  (sequence
    (havoc x)
    (assume (and (<= 0 x) (<= x 1.0)))
    (assign (y (- (/ x 2))))
    (! (sequence) :tag check)))
(annotate-tag check :check-true (< y 0))
(verify-call main ())
(get-witness)

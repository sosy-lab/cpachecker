; An annotation compares an array with a constant array
(set-logic QF_ALIA)
(define-proc main () () ((a (Array Int Int)) (i Int))
  (sequence
    (assign (a ((as const (Array Int Int)) 0)))
    (havoc i)
    (while (< i 10)
      (sequence
        (assign (a (store a i 0)))
        (assign (i (+ i 1)))))
    (! (sequence) :tag check)))
(annotate-tag check :check-true (= a ((as const (Array Int Int)) 0)))
(verify-call main ())
(get-witness)

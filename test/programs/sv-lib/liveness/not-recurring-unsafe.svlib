(set-logic LIA)

(set-info :format-version 1.0)

(define-proc
  main
  ()
  ()
  ((x Int))
  (! (sequence
    (assign (x 0))
    (! (while true (assign (x (+ x 1)))) :tag loop :not-recurring)) :tag main-body))

(verify-call main ())
(get-witness)

(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (n Int) (k Int))
  (!
    (sequence
      (assign (i 0))
      (assign (n 0))
      (if
        (not (and (<= k 1000000) (<= (- 1000000) k)))
        (sequence (assign (result 0)) (return)))
      (assign (i 0))
      (!
        (while
          (< i (* 2 k))
          (sequence
            (if (= (mod i 2) 0) (assign (n (+ n 1))))
            (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (or (< k 0) (= n k)))

(verify-call main ())

(get-witness)

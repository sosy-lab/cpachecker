; Both location invariants are violated on the same program path, so an analysis that does not
; stop at the first violation has to decide at the first one whether the counterexample continues.

(set-logic LIA)

(set-info :format-version 1.0)

(define-proc
  f1
  ()
  ()
  ((a Int))
  (! (sequence
    (assign (a 0))
    (! (assign (a 1)) :check-true (= a 5))
    (! (assign (a 2)) :check-true (= a 5))) :tag proc-f1))

(verify-call f1 ())

(set-logic LIA)

(set-info :format-version 1.0)

(define-proc
  main
  ()
  ()
  ((x Int) (y Int))
  (! (sequence
    (havoc x y)
    (! (sequence) :tag check :check-true (not (and (= x 1) (= y 2))))) :tag main-body))

(verify-call main ())
(get-witness)

(set-logic LIA)

(set-info :format-version 1.0)

(define-proc get () ((r Int)) () (! (sequence) :tag get-body))

(define-proc
  main
  ()
  ()
  ((a Int) (b Int))
  (! (sequence
       (call get () (a))
       (call get () (b))
       (! (sequence) :tag check :check-true (= a b)))
     :tag main-body))

(verify-call main ())
(get-witness)

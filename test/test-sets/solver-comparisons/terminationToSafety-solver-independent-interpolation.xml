<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="cpachecker" timelimit="900 s" hardtimelimit="1000 s" memlimit="15 GB" cpuCores="4">

  <option name="--heap">10000M</option>
  <option name="--benchmark"/>

  <!-- terminationToSafety encodes bitvectors to integers and floats to rationals per default, hence we do not include Bitwuzla for integer encodings. -->
  <option name="--terminationToSafety"/>

  <rundefinition name="mathsat5-integer">
    <option name="--option">solver.solver=mathsat5</option>
  </rundefinition>

  <!-- In theory nonLinearArithmetic should be irrelevant here. I want to test this with this rundef. -->
  <rundefinition name="mathsat5-bv-approx_non_linear">
    <option name="--option">solver.solver=mathsat5</option>
    <option name="--option">solver.nonLinearArithmetic=APPROXIMATE_ALWAYS</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <!-- In theory nonLinearArithmetic should be irrelevant here. I want to test this with this rundef. -->
  <rundefinition name="mathsat5-bv-precise_non_linear">
    <option name="--option">solver.solver=mathsat5</option>
    <option name="--option">solver.nonLinearArithmetic=USE</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="bitwuzla-bv">
    <option name="--option">solver.solver=bitwuzla</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="cvc5-integer">
    <option name="--option">solver.solver=cvc5</option>
  </rundefinition>

  <rundefinition name="z3_with_interpolation-integer">
    <!-- This is a distinct (old) Z3 version compared to solver.solver=Z3 that supports interpolation -->
    <option name="--option">solver.solver=Z3_WITH_INTERPOLATION</option>
  </rundefinition>

  <rundefinition name="cvc5-bv">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="z3_with_interpolation-bv">
    <!-- This is a distinct (old) Z3 version compared to solver.solver=Z3 that supports interpolation -->
    <option name="--option">solver.solver=Z3_WITH_INTERPOLATION</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="smtinterpol-integer">
    <option name="--option">solver.solver=smtinterpol</option>
  </rundefinition>

  <!-- Add Yices2 w native interpolation once JavaSMT 6.0.0+ is available. -->


  <!-- Projection-based Interpolation -->

  <rundefinition name="cvc5-integer-projection">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
  </rundefinition>

  <rundefinition name="z3-integer-projection">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
  </rundefinition>

  <rundefinition name="cvc5-bv-projection">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="z3-bv-projection">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="smtinterpol-integer-projection">
    <option name="--option">solver.solver=smtinterpol</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
  </rundefinition>

  <rundefinition name="bitwuzla-bv-projection">
    <option name="--option">solver.solver=bitwuzla</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_MODEL_BASED</option>
  </rundefinition>


  <!-- Forward Uniform Interpolation -->

  <rundefinition name="cvc5-integer-uniform_forward">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_FORWARD</option>
  </rundefinition>

  <rundefinition name="z3-integer-uniform_forward">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_FORWARD</option>
  </rundefinition>

  <rundefinition name="cvc5-bv-uniform_forward">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_FORWARD</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="z3-bv-uniform_forward">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_FORWARD</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="smtinterpol-integer-uniform_forward">
    <option name="--option">solver.solver=smtinterpol</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_FORWARD</option>
  </rundefinition>


  <!-- Backward Uniform Interpolation -->

  <rundefinition name="cvc5-integer-uniform_backward">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_BACKWARD</option>
  </rundefinition>

  <rundefinition name="z3-integer-uniform_backward">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_BACKWARD</option>
  </rundefinition>

  <rundefinition name="cvc5-bv-uniform_backward">
    <option name="--option">solver.solver=cvc5</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_BACKWARD</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="z3-bv-uniform_backward">
    <option name="--option">solver.solver=Z3</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_BACKWARD</option>
    <option name="--option">cpa.predicate.encodeBitvectorAs=BITVECTOR</option>
    <option name="--option">cpa.predicate.encodeFloatAs=FLOAT</option>
    <option name="--option">cpa.terminationviamemory.addConstraintsToPreventOverflows=false</option>
    <option name="--option">cpa.terminationviamemory.checkUFsInIntegerEncoding=false</option>
  </rundefinition>

  <rundefinition name="smtinterpol-integer-uniform_backward">
    <option name="--option">solver.solver=smtinterpol</option>
    <option name="--option">solver.interpolationMode=INDEPENDENT_UNIFORM_BACKWARD</option>
  </rundefinition>


  <!-- SV-COMP 2027 termination tasks -->
    <tasks name="C.termination.BitVectors">
      <includesfile>../sv-benchmarks/c/BitVectors-Termination.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="C.termination.MainControlFlow">
      <includesfile>../sv-benchmarks/c/ControlFlow-Termination.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="C.termination.MainHeap">
      <includesfile>../sv-benchmarks/c/Heap-Termination.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="C.termination.Other">
      <includesfile>../sv-benchmarks/c/Arrays.set</includesfile>
      <includesfile>../sv-benchmarks/c/BitVectors.set</includesfile>
      <includesfile>../sv-benchmarks/c/ControlFlow.set</includesfile>
      <includesfile>../sv-benchmarks/c/ECA.set</includesfile>
      <includesfile>../sv-benchmarks/c/Floats.set</includesfile>
      <includesfile>../sv-benchmarks/c/Heap.set</includesfile>
      <includesfile>../sv-benchmarks/c/Loops.set</includesfile>
      <includesfile>../sv-benchmarks/c/ProductLines.set</includesfile>
      <includesfile>../sv-benchmarks/c/Recursive.set</includesfile>
      <includesfile>../sv-benchmarks/c/Sequentialized.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="C.termination.SoftwareSystems-DeviceDriversLinux64">
      <includesfile>../sv-benchmarks/c/SoftwareSystems-DeviceDriversLinux64.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="C.termination.SoftwareSystems-uthash">
      <includesfile>../sv-benchmarks/c/SoftwareSystems-uthash.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>

</benchmark>

<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.9//EN" "https://www.sosy-lab.org/benchexec/benchmark-1.9.dtd">
<benchmark tool="cpachecker" timelimit="150 s" hardtimelimit="200 s" memlimit="7 GB" cpuCores="2">

  <option name="--no-output-files"/>
  <option name="--heap">6000M</option>

  <rundefinition>
    <option name="--smgSymbolicExecution"/>
  </rundefinition>

  <tasks name="C.valid-memsafety.Concurrency-Sequentialized">
    <option name="--option">analysis.preprocessing.MPOR=true</option>
    <includesfile>../programs/benchmarks/Concurrency.set</includesfile>
    <propertyfile>../programs/benchmarks/properties/valid-memsafety.prp</propertyfile>
  </tasks>

</benchmark>

<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.0//EN" "http://www.sosy-lab.org/benchexec/benchmark-1.0.dtd">
<benchmark tool="cpachecker" timelimit="120 s" hardtimelimit="180 s" memlimit="7 GB" cpuCores="2">

  <option name="--no-output-files"/>
  <option name="--heap">5000M</option>
  <option name="--sequentialization-concurrency"/>

  <rundefinition/>

  <!-- Different nondeterminismSource is used per property so that programs are not sequentialized with the same settings multiple times. -->
  <tasks name="C.valid-memsafety.NEXT_THREAD">
    <option name="--option">analysis.algorithm.MPOR.nondeterminismSource=NEXT_THREAD</option>
    <option name="--option">analysis.algorithm.MPOR.selectionEncodingForThreads=SWITCH_CASE</option>
    <includesfile>../programs/benchmarks/Concurrency.set</includesfile>
    <propertyfile>../programs/benchmarks/properties/valid-memsafety.prp</propertyfile>
  </tasks>

</benchmark>
